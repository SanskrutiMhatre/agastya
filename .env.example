# Copy to .env and fill in. Never commit .env.

# Port the API (and the built client) listens on.
PORT=3535

# Where agastya.db lives. Defaults to ./data.
# AGASTYA_DATA_DIR=./data

# First-run bootstrap of the single Software Administrator. Used only while no
# administrator exists; ignored afterwards. The password must meet the policy
# (8-128 characters, not a common password) and must be changed at first sign-in.
AGASTYA_INITIAL_ADMIN_USERNAME=admin
AGASTYA_INITIAL_ADMIN_PASSWORD=Temp@123

# Set to 1 to mark the session cookie Secure unconditionally.
# AGASTYA_SECURE_COOKIES=1

# Set to 1 only when a TLS-terminating reverse proxy sits in front of the
# server, so req.secure reflects X-Forwarded-Proto. Client IPs for rate
# limiting are always taken from the socket, never from headers.
# AGASTYA_TRUST_PROXY=1
