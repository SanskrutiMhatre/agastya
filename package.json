{
  "name": "agastya",
  "version": "0.1.0",
  "private": true,
  "description": "Agastya: S1000D publication authoring and publishing platform.",
  "main": "server/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "dev": "node --env-file-if-exists=.env --watch server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "test:security": "node security-regression.js",
    "test:all": "npm test && node security-regression.js",
    "reset-admin": "node --env-file-if-exists=.env scripts/reset-admin-password.js",
    "doctor": "node scripts/doctor.js",
    "golden": "node scripts/golden.mjs",
    "test:e2e": "npm run build:client && playwright test",
    "test:everything": "npm test && node security-regression.js && npm run doctor && npm run golden && npm run test:e2e",
    "content-models": "node scripts/build-content-models.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "multer": "^2.4.0",
    "ws": "^8.22.0",
    "xmllint-wasm": "^5.3.0",
    "xpath": "^0.0.34"
  },
  "optionalDependencies": {
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "pdfjs-dist": "^4.10.38"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
