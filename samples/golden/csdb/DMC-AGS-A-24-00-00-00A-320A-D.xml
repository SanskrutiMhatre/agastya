  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>The PDU-200 is installed in the radar cabinet.</reqCond>
          </reqCondNoRef>
          <reqCondNoRef>
            <reqCond>Both power supply modules are installed.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
        <reqPersons>
          <person man="A">
            <personCategory personCategoryCode="Maintainer"/>
            <trade>Electrical technician</trade>
            <estimatedTime unitOfMeasure="min">20</estimatedTime>
          </person>
        </reqPersons>
        <reqSupportEquips>
          <supportEquipDescrGroup>
            <supportEquipDescr id="seq-240320-01">
              <name>Digital multimeter</name>
              <identNumber>
                <manufacturerCode>0AGS1</manufacturerCode>
                <partAndSerialNumber>
                  <partNumber>DMM-87</partNumber>
                </partAndSerialNumber>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
          </supportEquipDescrGroup>
        </reqSupportEquips>
        <reqSupplies>
          <noSupplies/>
        </reqSupplies>
        <reqSpares>
          <noSpares/>
        </reqSpares>
        <reqSafety>
          <safetyRqmts>
            <warning>
              <warningAndCautionPara>Dangerous voltages are present in the PDU-200 when mains power is connected. Make sure the main circuit breaker is open and tagged before you start. If you do not, you can be killed or seriously injured.</warningAndCautionPara>
            </warning>
          </safetyRqmts>
        </reqSafety>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep id="stp-240320-01">
          <para>Close the main circuit breaker.</para>
        </proceduralStep>
        <proceduralStep id="stp-240320-02">
          <para>Make sure the green POWER indicator comes on and both amber indicators stay off.</para>
        </proceduralStep>
        <proceduralStep id="stp-240320-03">
          <para>Measure the voltage at test points TP1 and TP2 with the digital multimeter.</para>
          <proceduralStep id="stp-240320-04">
            <para>Make sure the voltage is between 27.7 V DC and 28.3 V DC.</para>
          </proceduralStep>
          <proceduralStep id="stp-240320-05">
            <para>If the voltage is out of limits, replace the power supply module. Refer to
              <dmRef>
            <dmRefIdent>
              <dmCode modelIdentCode="AGS" systemDiffCode="A" systemCode="24" subSystemCode="1" subSubSystemCode="0" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="520" infoCodeVariant="A" itemLocationCode="D"/>
            </dmRefIdent>
          </dmRef>.</para>
          </proceduralStep>
        </proceduralStep>
      </mainProcedure>
      <closeRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>Record the measured voltage in the maintenance log.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
      </closeRqmts>
    </procedure>
