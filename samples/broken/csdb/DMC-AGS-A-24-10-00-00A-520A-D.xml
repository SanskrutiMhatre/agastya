  <content>
    <procedure>
      <preliminaryRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>The radar cabinet is switched off at the main circuit breaker.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
        <reqPersons>
          <person man="A">
            <personCategory personCategoryCode="Maintainer"/>
            <trade>Electrical technician</trade>
            <estimatedTime unitOfMeasure="min">10</estimatedTime>
          </person>
        </reqPersons>
        <reqSupportEquips>
          <supportEquipDescrGroup>
            <supportEquipDescr id="seq-241520-01">
              <name>Torque screwdriver, 0.5 N.m to 3 N.m</name>
              <identNumber>
                <manufacturerCode>0AGS1</manufacturerCode>
                <partAndSerialNumber>
                  <partNumber>TS-0503</partNumber>
                </partAndSerialNumber>
              </identNumber>
              <reqQuantity>1</reqQuantity>
            </supportEquipDescr>
          </supportEquipDescrGroup>
        </reqSupportEquips>
        <reqSupplies>
          <noSupplies/>
        </reqSupplies>
        <reqSpares>
          <noSpares/>
        </reqSpares>
        <reqSafety>
          <safetyRqmts>
            <warning>
              <warningAndCautionPara>Dangerous voltages are present in the PDU-200 when mains power is connected. Make sure the main circuit breaker is open and tagged before you start. If you do not, you can be killed or seriously injured.</warningAndCautionPara>
            </warning>
            <caution>
              <warningAndCautionPara>The power supply module contains parts that electrostatic discharge can damage. Wear a grounded wrist strap.</warningAndCautionPara>
            </caution>
          </safetyRqmts>
        </reqSafety>
      </preliminaryRqmts>
      <mainProcedure>
        <proceduralStep id="stp-241520-01">
          <para>Make sure that the amber indicator for the module you will remove is on, or that the module is the one identified for replacement.</para>
        </proceduralStep>
        <proceduralStep id="stp-241520-02">
          <para>Loosen the <emphasis emphasisType="em03">two captive screws</emphasis> on the module front panel.</para>
        </proceduralStep>
        <proceduralStep id="stp-241520-03">
          <para>Pull the module straight out of its slot by its handle.</para>
          <note>
            <notePara>The other module continues to supply the full load while one module is removed.</notePara>
          </note>
        </proceduralStep>
        <proceduralStep id="stp-241520-04">
          <para>Put the module in an anti-static bag:<randomList><listItem><para>Seal the bag.<randomList><listItem><para>Fold the top twice.</para></listItem></randomList></para></listItem></randomList></para>
        </proceduralStep>
      </mainProcedure>
      <closeRqmts>
        <reqCondGroup>
          <reqCondNoRef>
            <reqCond>Install a serviceable module before the radar is put back into service.</reqCond>
          </reqCondNoRef>
        </reqCondGroup>
      </closeRqmts>
    </procedure>
