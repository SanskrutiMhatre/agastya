                    </dmTitle>
                </dmAddressItems>
            </dmAddress>
            <dmStatus issueType="new">
                <security securityClassification="02"/>
            </dmStatus>
        </identAndStatusSection>
        <content>
            <illustratedPartsCatalog>
                <catalogSeqNumber figureNumber="01" item="001" indenture="1">
                    <itemSeqNumber>
                        <partSegment>
                            <itemIdentData>
                                <manufacturerCode>K1234</manufacturerCode>
                                <partNumber>PDU-ASSY-001</partNumber>
                            </itemIdentData>
                            <descrForPart>Power Distribution Unit Assembly</descrForPart>
                            <quantityPerNextHigherAssy>1</quantityPerNextHigherAssy>
                            <unitOfIssue>EA</unitOfIssue>
                        </partSegment>
                    </itemSeqNumber>
                </catalogSeqNumber>
                <catalogSeqNumber figureNumber="01" item="002" indenture="2">
                    <itemSeqNumber>
                        <partSegment>
                            <itemIdentData>
                                <manufacturerCode>K1234</manufacturerCode>
                                <partNumber>PDU-REG-010</partNumber>
                            </itemIdentData>
                            <descrForPart>Regulator Module</descrForPart>
                            <quantityPerNextHigherAssy>2</quantityPerNextHigherAssy>
